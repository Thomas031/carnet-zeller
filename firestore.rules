rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function thomas() {
      return request.auth != null && request.auth.uid == 'UID_THOMAS';
    }
    function member() {
      return thomas() || (request.auth != null && request.auth.uid == 'UID_AMI');
    }
    match /folders/{id} {
      allow read: if member();
      allow create, update: if member()
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
    }
    match /courses/{id} {
      allow read: if member();
      function valid() {
        let data = request.resource.data;
        return member() && id.matches('[a-f0-9-]{36}')
          && data.keys().hasOnly(['id','title','matter','chapter','folder','date','html','rev','updated','files'])
          && data.id == id && data.rev is int && data.updated is int
          && data.title is string && data.matter is string && data.chapter is string
          && data.folder is string && data.date is string && data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && data.html is string && data.files is list && data.files.size() <= 100;
      }
      allow create: if valid() && request.resource.data.rev == 1;
      allow update: if valid() && request.resource.data.rev == resource.data.rev + 1;
    }
    match /admin/settings {
      allow read: if thomas();
      allow create, update: if thomas()
        && request.resource.data.keys().hasOnly(['notes'])
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 4000;
    }
  }
}
